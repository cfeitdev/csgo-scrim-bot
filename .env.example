# --- Discord ---
DISCORD_TOKEN=your-bot-token-here
# Optional: sync slash commands instantly to one guild while developing.
DISCORD_GUILD_ID=

# --- CS:GO / CS2 server RCON ---
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=your-rcon-password
# Set to 0 to run the bot in "dry run" mode (no map change is sent).
RCON_ENABLED=1
# What players type into their console. Defaults to RCON_HOST:RCON_PORT.
CONNECT_ADDRESS=

# --- Steam ---
# Optional. Without it /register still accepts steamID64 / STEAM_1:0:x / [U:1:x],
# it just cannot resolve custom (/id/vanity) profile URLs or fetch persona names.
STEAM_API_KEY=

# --- Scrim tuning ---
LOBBY_SIZE=10
# Seconds a captain has to pick/ban before the bot auto-picks. 0 disables.
PICK_TIMEOUT=120
DEFAULT_ELO=1000
DEFAULT_GAMEMODE=5v5
STORE_PATH=data/store.json

# --- get5 (https://github.com/splewis/get5) -------------------------------
# Targets get5 0.6.0. The integration is OFF until you set GET5_BASE_URL or
# GET5_CONFIG_DIR. Every player must /register a Steam account when it is on.
#
# Option A -- URL. The bot serves the match config over HTTP and the server
# fetches it with get5_loadmatch_url. Needs the SteamWorks extension on the
# game server. GET5_BASE_URL is how the GAME SERVER reaches the bot.
GET5_BASE_URL=
GET5_HTTP_HOST=0.0.0.0
GET5_HTTP_PORT=8080
# Optional shared secret sent as an HTTP header with get5_loadmatch_url.
GET5_AUTH_HEADER=
GET5_AUTH_VALUE=
#
# Option B -- file. Use instead of a URL when the bot can write somewhere the
# game server reads. GET5_CONFIG_DIR is the bot's local path; GET5_CONFIG_PREFIX
# is the same folder as the server sees it, relative to its csgo directory.
GET5_CONFIG_DIR=
GET5_CONFIG_PREFIX=addons/sourcemod/configs/get5

# Seconds to wait after changelevel before loading the match config.
GET5_LOAD_DELAY=15
# Auto-start: poll the server and fire get5_forceready once all 10 connect.
GET5_AUTOSTART=1
GET5_POLL_INTERVAL=10
# How long to wait for the server to answer RCON again after a map change.
GET5_LOAD_TIMEOUT=120
GET5_READY_TIMEOUT=900
# Consecutive polls with the full roster in game before the match is readied up.
GET5_READY_POLLS=2
# How long to watch a live match for its final score before giving up.
GET5_MATCH_TIMEOUT=10800
# Seconds a /testfill bot waits before making its pick or ban.
TEST_BOT_DELAY=1.5

# Match config format: "kv" (KeyValues) or "json". Blank picks automatically --
# KeyValues for file mode, JSON for URL mode. get5 0.6.0 needs the smjansson
# SourceMod extension to read JSON; KeyValues needs no extension at all, so
# leave this blank unless you know smjansson is installed.
GET5_CONFIG_FORMAT=

# Where get5 writes its match stats file. Blank derives the server's csgo
# directory from GET5_CONFIG_DIR minus GET5_CONFIG_PREFIX, which is correct
# for a standard install. This is how the bot reads the final score when the
# smjansson extension is absent.
GET5_STATS_DIR=
GET5_STATS_FORMAT=get5_matchstats_{MATCHID}.cfg

# --- NA game server (optional) ----------------------------------------------
# Everything above is the EU server. Set NA_SSH_HOST and players vote EU or NA
# while the draft and veto run; leave it blank and nothing changes.
# The bot reaches NA over one SSH connection: SFTP for the get5 match config
# and stats file, and RCON tunnelled through it -- NA's RCON port stays on
# localhost. Needs `pip install asyncssh`.
NA_SSH_HOST=
NA_SSH_PORT=22
NA_SSH_USER=
# Private key the bot logs in with, and a known_hosts file holding NA's host
# key. The host key is always checked: the RCON password rides this link.
NA_SSH_KEY=
NA_SSH_KNOWN_HOSTS=
# RCON as seen from the NA machine itself (srcds binds it to localhost).
NA_RCON_HOST=127.0.0.1
NA_RCON_PORT=27015
NA_RCON_PASSWORD=
# What players type into their console for NA.
NA_CONNECT_ADDRESS=
# Paths ON THE NA MACHINE. Required when get5 is on. NA always runs get5 in
# file mode, like EU, so it needs no extra SourceMod extension.
NA_GET5_CONFIG_DIR=
NA_GET5_CONFIG_PREFIX=addons/sourcemod/configs/get5
# Blank derives the csgo directory from NA_GET5_CONFIG_DIR.
NA_GET5_STATS_DIR=

# Command sync: auto (only when commands changed), always, or never.
# Discord rate limits command writes per guild, and the sync blocks startup.
SYNC_COMMANDS=auto
